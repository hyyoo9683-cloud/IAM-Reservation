rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 예약·공간·차단일은 누구나 읽기 가능 (공개 캘린더용), 쓰기는 로그인 필요
    match /reservations/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /spaces/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blockedDates/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 나머지는 로그인한 사용자만
    match /allowedUsers/{doc} {
      allow read, write: if request.auth != null;
    }
    match /orgs/{doc} {
      allow read, write: if request.auth != null;
    }
    match /notices/{doc} {
      allow read, write: if request.auth != null;
    }
    match /quotations/{doc} {
      allow read, write: if request.auth != null;
    }
    match /venue_requests/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
