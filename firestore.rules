rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 예약·공간·차단일은 누구나 읽기 가능 (공개 캘린더용), 쓰기는 로그인 필요
    match /reservations/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /spaces/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blockedDates/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 공지사항: 누구나 읽기 가능, 쓰기는 로그인 필요
    match /notices/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 사이트 콘텐츠(FAQ·센터 소개): 누구나 읽기 가능, 쓰기는 로그인 필요
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 나머지는 로그인한 사용자만
    match /allowedUsers/{doc} {
      allow read, write: if request.auth != null;
    }
    // 관리자 목록: 주 관리자(hyyoo9683@gmail.com) 또는 이미 등록된 관리자만 추가/삭제 가능
    match /admins/{email} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.email == 'hyyoo9683@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    match /adminNotes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /orgs/{doc} {
      allow read, write: if request.auth != null;
    }
    match /quotations/{doc} {
      allow read, write: if request.auth != null;
    }
    match /venue_requests/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // 퇴실 체크: 누구나 제출 가능, 조회·수정·삭제는 로그인 필요
    match /checkouts/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // 시스템 메타데이터 (저장공간 정리 마지막 실행 시각 등): 로그인한 사용자만
    match /system/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
