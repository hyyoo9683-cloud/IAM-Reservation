rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── 권한 판별 함수 ─────────
    // 화면(브라우저)에서만 막던 도메인·관리자 확인을 서버 규칙에서도 동일하게 확인한다.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email; }
    function myName() { return request.auth.token.get('name', ''); }

    // 관리자: 주 관리자 또는 admins 컬렉션에 등록된 계정 (index.html의 isAdmin과 동일)
    function isAdmin() {
      return signedIn() && (
        myEmail() == 'hyyoo9683@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(myEmail()))
      );
    }
    // 예약 사용자: 관리자 + @suwoncca.org 계정 + 외부 허용 계정(allowedUsers)
    // (인트라넷은 관리자 전용 — 일반 구성원은 예약 신청·내 예약만 사용)
    function isMember() {
      return isAdmin()
        || (signedIn() && myEmail().matches('.*@suwoncca[.]org$'))
        || (signedIn() && exists(/databases/$(database)/documents/allowedUsers/$(myEmail())));
    }
    function sameEmail(a) { return a is string && a.lower() == myEmail().lower(); }

    // ───────── 예약 ─────────
    match /reservations/{doc} {
      // 원본(이름·연락처·이메일 포함)은 관리자와 본인만 읽기.
      // 공개 화면은 개인정보가 빠진 publicReservations 사본을 읽는다.
      // 본인 = 신청 이메일이 같거나, 담당자·청지기 이름이 로그인 계정 실명과 같은 구성원
      //        (index.html renderMyList의 '내 예약' 기준과 동일)
      allow read: if isAdmin()
        || (signedIn() && resource.data.userEmail == myEmail())
        || (isMember() && myName() != ''
            && (resource.data.managerName == myName()
                || resource.data.stewardName == myName()));

      // 관리자: 전체 관리
      allow create, update, delete: if isAdmin();

      // 사용자: 본인 이메일로, '대기' 상태로만 신청
      allow create: if isMember()
        && sameEmail(request.resource.data.get('userEmail', ''))
        && request.resource.data.get('status', '대기') == '대기';

      // 사용자: 본인 예약만 수정 — 신청자 변경 불가.
      //  · '대기' 상태: 내용 수정 가능 (상태는 그대로 두거나 '취소'만)
      //  · '확정' 상태: 내용(공간·날짜·시간 등) 수정 불가, '취소'로만 바꿀 수 있음(status·history·processedAt만 변경)
      allow update: if isMember()
        && sameEmail(resource.data.get('userEmail', ''))
        && request.resource.data.get('userEmail', '') == resource.data.get('userEmail', '')
        && (
          (resource.data.get('status', '') == '대기'
            && (request.resource.data.get('status', '') == '대기'
                || request.resource.data.get('status', '') == '취소'))
          || (resource.data.get('status', '') == '확정'
            && request.resource.data.get('status', '') == '취소'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'history', 'processedAt']))
          || (resource.data.get('status', '') == '취소'
            && request.resource.data.get('status', '') == '취소')
        );

      // 사용자: 본인 예약 삭제 — 확정된 예약은 삭제 불가(취소만), 대기·취소 건만 삭제 가능
      allow delete: if isMember() && sameEmail(resource.data.get('userEmail', ''))
        && resource.data.get('status', '') != '확정';
    }

    // 공개용 예약 사본: 개인정보 없는 필드만 담김 (Cloud Function만 기록)
    match /publicReservations/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ───────── 공개 읽기 + 관리자 쓰기 ─────────
    match /spaces/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blockedDates/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 사이트 콘텐츠(FAQ·센터 소개·홈페이지 문구): 누구나 읽기, 관리자만 수정
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 홈페이지 이전 게시본 보관 (편집 모드 '게시하기'·관리자 페이지 '되돌리기'에서 기록)
    match /siteContentHistory/{doc} {
      allow read, write: if isAdmin();
    }
    // 홈페이지 공연·행사: 공개(published) 항목만 누구나 읽기, 관리자는 전체 읽기·쓰기
    match /programs/{doc} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    // 공지사항: 누구나 읽기, 관리자만 쓰기
    match /notices/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ───────── 계정 관리 ─────────
    // 관리자 목록: 본인 문서 확인만 허용, 목록 조회·추가·삭제는 관리자
    match /admins/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    // 외부 허용 계정: 본인 문서 확인만 허용, 목록·관리는 관리자
    match /allowedUsers/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list, write: if isAdmin();
    }
    // 로그인 기록: 본인 기록만 작성, 조회·관리는 관리자
    match /loginUsers/{email} {
      allow get: if isMember() && email == myEmail();
      allow create, update: if isMember() && email == myEmail()
        && request.resource.data.keys().hasOnly(
             ['email', 'name', 'firstLoginAt', 'lastLoginAt', 'loginCount', 'isAdmin', 'manual', 'importedFromReservations']);
      allow read, write: if isAdmin();
    }

    // ───────── 관리자 전용 ─────────
    match /adminNotes/{doc} {
      allow read, write: if isAdmin();
    }
    match /system/{doc} {
      allow read, write: if isAdmin();
    }

    // ───────── 기관 분류(예약 신청 폼) / 인트라넷(관리자 전용) ─────────
    match /orgs/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /quotations/{doc} {
      allow read, write: if isAdmin();
    }
    match /eventChecklists/{doc} {
      allow read, write: if isAdmin();
    }
    match /managerChecklists/{doc} {
      allow read, write: if isAdmin();
    }

    // ───────── 누구나 제출, 관리자가 처리 ─────────
    // 공개 폼은 로그인 없이 제출 가능(의도). 대신 필드 수를 제한하고 처리 상태는 초기값으로 고정한다.
    match /venue_requests/{doc} {
      allow create: if request.resource.data.keys().size() <= 60
        && request.resource.data.get('status', '접수') == '접수';
      allow read, update, delete: if isAdmin();
    }
    match /checkouts/{doc} {
      allow create: if request.resource.data.keys().size() <= 20;
      allow read, update, delete: if isAdmin();
    }
    match /changeRequests/{doc} {
      allow create: if request.resource.data.keys().size() <= 20
        && request.resource.data.get('status', '대기') == '대기';
      allow read, update, delete: if isAdmin();  // 신청자 이름·연락처 포함 → 관리자만
    }
  }
}
