# Resend API 키 (https://resend.com/api-keys 에서 발급, 비밀값 — 절대 커밋 금지)
RESEND_API_KEY=

# 발신 주소. 도메인 인증 전에는 비워두면 기본값(onboarding@resend.dev, 본인 계정으로만 발송 가능)이 쓰인다.
# 서브도메인(예: mail.suwoncca.org) 인증 완료 후 아래처럼 설정.
RESEND_FROM_EMAIL=IAM Center 예약시스템 <noreply@mail.suwoncca.org>

# 메일 내 "예약 상세보기" 버튼이 연결할 앱 주소. 기본값(https://iamreservation.web.app)과 다를 때만 설정.
APP_BASE_URL=https://iamreservation.web.app
