# Resend API 키 (https://resend.com/api-keys 에서 발급, 비밀값 — 절대 커밋 금지)
RESEND_API_KEY=

# 발신 주소. 도메인 인증 전에는 비워두면 기본값(onboarding@resend.dev, 본인 계정으로만 발송 가능)이 쓰인다.
# 서브도메인(예: mail.suwoncca.org) 인증 완료 후 아래처럼 설정.
RESEND_FROM_EMAIL=IAM Center 예약시스템 <noreply@mail.suwoncca.org>

# 메일 내 "예약 상세보기" 버튼이 연결할 앱 주소. 기본값(https://iamreservation.web.app)과 다를 때만 설정.
APP_BASE_URL=https://iamreservation.web.app

# 새 예약·변경취소·대관 신청이 들어왔을 때 관리자 알림 메일을 받을 주소.
# 비워두면 주 관리자 이메일(hyyoo9683@gmail.com)로 간다.
ADMIN_NOTIFY_EMAIL=

# 카카오톡 "나에게 보내기" 관리자 알림 (Kakao Developers 앱 > 앱 키 > REST API 키).
# 비밀값 아님(OAuth client_id로 쓰임) — 다만 .env는 어차피 커밋하지 않으므로 그대로 보관.
KAKAO_REST_API_KEY=

# 앱 > 보안 > Client Secret을 켰을 때만 필요. 안 켰으면 비워둔다.
KAKAO_CLIENT_SECRET=

# kakao-auth.html에서 로그인 동의 후 돌아올 주소 — Kakao Developers의 Redirect URI와 정확히 일치해야 함.
KAKAO_REDIRECT_URI=https://iamreservation.web.app/kakao-auth-callback.html

# 문자(SMS) 관리자 알림 — 알리고(https://smartsms.aligo.in) API 키·사용자 ID·사전 등록한 발신번호.
# 알리고는 발송 서버 IP를 미리 등록해야 하는 방식이라 등록되지 않은 IP에서는 인증 오류가 날 수 있음.
ALIGO_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
# 알림 문자를 받을 관리자 휴대폰 번호(숫자만 또는 하이픈 포함). 비워두면 문자 알림은 보내지 않음.
ADMIN_NOTIFY_PHONE=
